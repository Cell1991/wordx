# ==============================================================================
# Crossword Game - Environment Configuration Template
# Copy this file to '.env' (or '.env.local') and fill in your actual private values.
# NEVER commit your actual '.env' file or production credentials to Git!
# ==============================================================================

# Database Connection (Backend)
# Local development fallback uses SQLite if left blank:
# DATABASE_URL=sqlite+aiosqlite:///crossword.db
# Production PostgreSQL (Supabase / Render / Neon):
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=require
SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>

# Security & Permissions
# Set to 'false' in production. If 'true', god-mode debugging endpoints are active.
DEBUG_MODE=false
# Secret key to authorize administrative operations (e.g. wiping match history via DELETE /api/history)
ADMIN_SECRET_KEY=

# CORS Configuration
# Comma-separated list of allowed frontend origins, or '*' for all origins.
CORS_ORIGINS=https://crosswordx-game.vercel.app,http://localhost:3000

# Frontend API & WebSocket Endpoints (used by Next.js client)
NEXT_PUBLIC_API_URL=https://crossword-backend.onrender.com/api
NEXT_PUBLIC_WS_URL=wss://crossword-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://crosswordx-game.vercel.app

# Ngrok Authentication & Custom Domain (Optional - for local tunneling)
# Get free token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
